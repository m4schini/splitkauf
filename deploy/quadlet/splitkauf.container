[Unit]
Description=Splitkauf application server
# Start only after migrations have applied; splitkauf-migrate in turn requires
# the (healthy) database, so this transitively depends on both.
Requires=splitkauf-migrate.service
After=splitkauf-migrate.service

[Container]
Image=ghcr.io/m4schini/splitkauf:latest
ContainerName=splitkauf
Exec=serve
Network=splitkauf.network
PublishPort=8080:8080
EnvironmentFile=/etc/splitkauf/splitkauf.env
# Let `podman auto-update` pull a newer :latest and restart this unit. Enable
# the podman-auto-update.timer to run it periodically. Note: auto-update only
# swaps the app image — it does not run migrations, so a release that ships new
# migrations still needs `systemctl restart splitkauf-migrate.service` first.
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target

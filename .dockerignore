# Never ship (or shadow) local dependency/build artifacts — the Dockerfile
# rebuilds these from source inside each stage.
frontend/node_modules
# A stale local dist must never shadow the node-stage build's output.
ports/web/dist

.git
data
coverage*
docs

# Local secrets and editor state must never reach an image layer.
.env
.env.*
*.pem
.idea
.vscode

# Local build outputs and CI reports (see .gitignore).
/splitkauf
test-report.json
lint-debt.json
diff-cover.json
.golangci.debt.yml
baseline
